DATABASE_URL=postgresql://user:password@localhost:5432/ranchi
CRON_SECRET=replace-me-generate-with-openssl-rand-hex-32
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here
# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173
# OPTIONAL and OFF by default. Only set this for preview environments — never in production.
# Example (Vercel previews): CORS_ORIGIN_REGEX=https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# Optional: enable Sentry error reporting by setting a DSN. Leave blank to disable.
SENTRY_DSN=
